// Every value has to be duplicated on top of itself. Each dup pushes the deeper sources out of reach, so the
// plan drops slots until the dups are possible: with spilling allowed the deepest values get spilled and reloaded.
allowSpilling: true
initial: [v1, v2, v3, v4, v5, v6, v7, v8]
targetStackTop: [v1, v2, v3, v4, v5, v6, v7, v8, v1, v2, v3, v4, v5, v6, v7, v8]
